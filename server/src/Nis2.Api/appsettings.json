{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=nis2.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "RateLimiting": {
    "PermitLimit": 30,
    "Window": "00:01:00"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
